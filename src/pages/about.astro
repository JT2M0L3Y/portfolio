---
import { site } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="About" description={site.about.description}>
	<div class="space-y-10">
		<header class="animate">
			<h1
				class="mb-3 font-sans text-xl font-semibold text-stone-900 dark:text-stone-100"
			>
				About
			</h1>
			<p class="font-serif text-stone-600 dark:text-stone-300">
				{site.about.description}
			</p>
		</header>

		{
			site.about.sections.map((section) => (
				<section class="animate">
					<h2 class="mb-4 font-sans text-base font-semibold text-stone-900 dark:text-stone-100">
						{section.heading}
					</h2>
					<div class="space-y-4 font-serif leading-7 text-stone-600 dark:text-stone-300">
						{section.paragraphs.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</div>
				</section>
			))
		}
	</div>
</SiteLayout>
